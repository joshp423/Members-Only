<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Membership Gateway</title>
</head>
<body></body>
 <% if (locals.user) {%>
    <h1>Enter the password to become a member</h1>
    <%- include("partials/errors.ejs") %>
    <form action="/membership-gateway" method="POST">
      <label for="password">Membership Password:</label>
      <input id="password" name="password" type="text" />
      <button type="submit">Submit</button>
    </form>
<% } else { %>
  <h1>You are not logged in</h1>
<%}%>
</body>
</html>
