<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Log In</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/navbar') %>
    <% if (locals.user) {%>
        <div class="titleLinks">
            <h1>Welcome Back <%= user.firstname %>.</h1>
            <div>
                <a href="/new-message"><button>Write New Message</button></a>
                <a href="/membership-gateway"><button>Membership Gateway</button></a>
            </div>
        </div>
    <% } else { %>
        <div class="loggedOut">
            <h1>Log in to create messages</h1>
            <p>Logged in users who are members can view message sender identities.</p>
            <form action="/log-in" method="POST">
            <label for="username">Email</label>
            <input id="username" name="username" placeholder="email" type="email" />
            <label for="password">Password</label>
            <input id="password" name="password" type="password" />
            <button type="submit">Log In</button>
            </form>
        </div>
    <%}%>
    <%- include('messages/messageBoard', {messages, user}) %>
</body>
</html>
