<div class="messageTile">
    <h1>Title: <%= message.title %></h1>
    <h2>Message: <%= message.text %></h2>
    <% if (locals.user) {%>
        <% if (locals.user.membershipstatus) {%>
            <h3>Sent By: <%= message.firstname %> <%= message.lastname %></h3>
        <% } if (locals.user.adminstatus) { %>
            <a href="/delete-message/<%= message.id %>"><button>Delete Message</button></a>
        <% } else { %>
            <h3>Sent By: Anonymous User</h3>
        <% }; %>
    <% } else { %>
        <h3>Sent By: Anonymous User</h3>
    <% }; %>
    <p> Sent at: <%= message.timeadded %></p>
</div>